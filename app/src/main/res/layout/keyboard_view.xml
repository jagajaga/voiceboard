<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#141A12"
    android:padding="12dp">

    <!-- Top row: Auto-newline toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnAutoNewline"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="↵  New line: off"
            android:textSize="11sp"
            android:textColor="#7A8A74"
            android:backgroundTint="#1F2A1D"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Status / transcript preview -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#7A8A74"
        android:textSize="12sp"
        android:gravity="center"
        android:minHeight="20dp"
        android:maxLines="3"
        android:ellipsize="none"
        android:paddingBottom="6dp" />

    <!-- Retry / Save-audio row — visible only after a failed transcription -->
    <LinearLayout
        android:id="@+id/rowRetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="🔁  Retry"
            android:textSize="14sp"
            android:textColor="#E8EDE3"
            android:backgroundTint="#4A3A28"
            android:stateListAnimator="@null"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSaveAudio"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="💾  Save audio"
            android:textSize="14sp"
            android:textColor="#E8EDE3"
            android:backgroundTint="#4A3A28"
            android:stateListAnimator="@null"
            android:layout_marginStart="4dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Rephrase button — visible only when text is selected -->
    <Button
        android:id="@+id/btnRephrase"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="✏️  Rephrase selection"
        android:textSize="14sp"
        android:textColor="#E8EDE3"
        android:backgroundTint="#2A3828"
        android:stateListAnimator="@null"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <!-- Main record button -->
    <Button
        android:id="@+id/btnRecord"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:text="🎤  Record"
        android:textSize="19sp"
        android:textColor="#E8EDE3"
        android:backgroundTint="#3A4438"
        android:stateListAnimator="@null"
        android:layout_marginBottom="8dp" />

    <!-- Bottom row: Delete + Switch keyboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="⌫  Delete"
            android:textSize="14sp"
            android:textColor="#E8EDE3"
            android:backgroundTint="#2D3830"
            android:stateListAnimator="@null"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSwitch"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="⌨  Keyboard"
            android:textSize="14sp"
            android:textColor="#E8EDE3"
            android:backgroundTint="#3A4438"
            android:stateListAnimator="@null"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</LinearLayout>
